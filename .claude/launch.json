{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-convex",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "env": {
        "VITE_BACKEND": "convex"
      },
      "port": 5175
    },
    {
      "name": "convex-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "convex",
        "--",
        "--typecheck",
        "disable"
      ],
      "port": 3212
    }
  ]
}