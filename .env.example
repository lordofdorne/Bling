APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://bling:bling@localhost:5432/bling?sslmode=disable
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL=720h
BCRYPT_COST=12
AUTH_RATE_LIMIT_WINDOW=1m
REALTIME_RATE_LIMIT_WINDOW=1m
REALTIME_CONNECT_LIMIT=60
REALTIME_CLIENT_BUFFER=16
REALTIME_MAX_PER_SHOW=10000
REALTIME_HEARTBEAT=25s
REALTIME_WRITE_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
READINESS_TIMEOUT=2s
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
# Coturn REST API shared secret. Production requires short-lived credentials.
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=15m
# Static credentials are supported only for local development.
TURN_USERNAME=
TURN_CREDENTIAL=
CALL_PRESENCE_TTL=45s
CALL_DISCONNECT_GRACE=20s
# Stripe test-mode keys. Leave both blank to run free tiers without payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Created by `stripe listen --forward-to localhost:8080/api/v1/payments/webhook`.
STRIPE_WEBHOOK_SECRET=
